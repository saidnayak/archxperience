# ArchXperience Supabase Cloud Configuration
# Retrieve these values from your Supabase Project Settings -> API

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous / Public API Key (NEVER use service_role here!)
# Supports either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=sb_publishable_or_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=